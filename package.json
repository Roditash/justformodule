{
  "name": "inventario-mesas-sillas",
  "version": "1.0.0",
  "description": "Sistema web para gestión, reservas, préstamos y devoluciones de mesas y sillas",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "deploy:vercel": "bash scripts/deploy-vercel.sh",
    "test": "node --test",
    "seed": "node src/seed.js",
    "migrate:sqlite": "node scripts/migrate-sqlite-to-neon.js",
    "migrate:sqlite:apply": "node scripts/migrate-sqlite-to-neon.js --apply"
  },
  "dependencies": {
    "better-sqlite3": "^11.1.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
